# Copy to .env and fill in. The binary reads .env at startup; real environment
# variables win over it, so `FOO=bar ./ask-my-docs …` still overrides for
# one-off experiments.
#
# Nothing here is guessed for you. Model choices in particular have no
# defaults — the app fails at startup naming the variable rather than indexing
# a corpus with a model you did not pick.

# ============================================================================
# 1. WHICH BACKEND RUNS EACH STAGE
# ============================================================================
# The three stages are independent because they have different constraints:
# embedding is high-volume, reranking is latency-critical, generation is
# quality-critical. Mixing is expected — e.g. embed and rerank locally, but
# generate with a large hosted model you have no VRAM to run.

# Embeddings (and, unless overridden below, generation).
#   ollama = local
#   cloud  = Voyage embeddings + Claude generation
#   nvidia = NVIDIA NIM embeddings + generation (needs RERANKER_URL: NIM's
#            chat/embeddings endpoints serve no cross-encoder)
PROVIDER=ollama

# Overrides ONLY generation, verification and contextualization.
# Leave empty to follow PROVIDER.
#   ollama | cloud | openai | nvidia   (openai = any OpenAI-compatible endpoint)
LLM_PROVIDER=

# ============================================================================
# 2. LOCAL MODELS (PROVIDER=ollama)
# ============================================================================
# Required — no defaults. `ollama list` shows what you have.
# Embedding model must actually support embeddings; a chat model returns 501.
#   good starting points: bge-m3 (1024-dim), mxbai-embed-large, nomic-embed-text
OLLAMA_EMBED_MODEL=
# Any instruct-tuned chat model. Bigger is materially better here — a 7B
# refused questions its own sources answered until several fixes landed.
OLLAMA_CHAT_MODEL=

OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_SEED=42                     # fixed so eval runs are reproducible
OLLAMA_CONCURRENCY=4               # raise on a bigger GPU
OLLAMA_RERANK_BATCH=10             # only used when RERANKER_URL is unset
OLLAMA_CONTEXT_BATCH=8

# Asymmetric embedding models encode queries and passages differently and
# retrieve badly without their prefixes. bge-m3 needs none; nomic-embed-text
# wants these two:
#   OLLAMA_DOC_PREFIX=search_document:
#   OLLAMA_QUERY_PREFIX=search_query:
OLLAMA_DOC_PREFIX=
OLLAMA_QUERY_PREFIX=

# ============================================================================
# 3. HOSTED GENERATION (LLM_PROVIDER=openai)
# ============================================================================
# Works with Groq, OpenRouter, Together, Fireworks, vLLM, LM Studio — the wire
# format is identical. None of them serve embeddings or reranking, so this
# replaces generation only; retrieval stays wherever PROVIDER points.
# OPENAI_API_KEY=
# OPENAI_MODEL=                    # required when LLM_PROVIDER=openai
#
#   Groq (default base URL):   OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:                OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                              OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MAX_TOKENS=4096
OPENAI_CONTEXT_BATCH=20
OPENAI_CONCURRENCY=4               # drop to 1 if a free tier rate-limits ingest
# Total time one request may spend backing off on 429s, summed across its
# retries — not a per-sleep cap. Per-MINUTE limits are worth waiting out;
# per-DAY limits are not — past this budget the request fails with the
# provider's own message ("tokens per day (TPD): Limit 100000...") instead of
# sleeping for hours and reporting a meaningless timeout.
OPENAI_MAX_BACKOFF_SEC=45

# ============================================================================
# 3b. NVIDIA NIM  (PROVIDER=nvidia and/or LLM_PROVIDER=nvidia)
# ============================================================================
# The one hosted endpoint here that serves embeddings as well as chat, so it
# can drive retrieval too. Reranking still comes from RERANKER_URL.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b     # generation
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b        # 2048-dim, 32k context
#
# Nemotron takes its reasoning switch in the system prompt, not a request
# field. Left in the default thinking mode one generation spent 8192 output
# tokens reasoning and never reached the JSON (197s, truncated); with the
# directive below the same call answered in 1.8s and 172 tokens. Set it to
# "detailed thinking on" for a model where the reasoning earns its tokens.
NVIDIA_SYSTEM_PREFIX=detailed thinking off
#
# Contextualization sends a whole document per request. Nemotron reasons over
# all of it and can still blow past OPENAI_MAX_TOKENS, in which case ingest
# warns and indexes raw chunks — which measurably hurts reranking. Point
# LLM_PROVIDER at a cheap non-reasoning model for ingest if you hit that.

# ============================================================================
# 3c. ENTAILMENT VERIFIER
# ============================================================================
# Both default to the generator, which means the model that wrote a claim also
# rules on whether its own citations support it — the weakest form of a check
# whose whole purpose is to be independent.
#
# VERIFY_MODEL alone is enough to split them: it implies the verify stage and
# reuses LLM_PROVIDER's endpoint, which is what you want when the generator and
# the verifier live on the same API but must not be the same model.
#
# Verification is also the biggest token consumer of any stage — binary
# classification over long evidence — so it is the first to hit a tokens-per-
# minute cap. VERIFY_PROVIDER=ollama moves that load onto a GPU that is
# otherwise idle between queries.
# VERIFY_PROVIDER=                 # ollama | cloud | openai | nvidia
# VERIFY_MODEL=

# ============================================================================
# 3e. CONTEXTUALIZER  (ingest only)
# ============================================================================
# The stage that decides how long ingest takes. Everything else — extraction,
# chunking, embedding, indexing — is algorithmic and fast: measured on a
# 302-page document (780 chunks), all of it together took 19s. Writing the
# situating preamble took 14m14s more through a local 7B, because it is one
# model call per batch of chunks and this one document needs ~100 of them.
#
# It is also the *easiest* task any model here does: one sentence saying where
# a chunk sits in its document. It does not need the model that writes answers,
# which is why it is separable.
#
#   CONTEXT_PROVIDER=none    no model call at all. Chunks still get a context
#                            line, derived from filename and heading path — so
#                            this is "no LLM", not "no context". 19s for that
#                            302-page document. This is what textbook RAG does.
#   CONTEXT_PROVIDER=ollama  keep it local and off a metered endpoint
#   CONTEXT_MODEL=           a smaller model than the generator
#
# Measured rerank scores for the same chunks under each: 0.0001-0.0014 with no
# context at all, 0.010-0.094 with the derived line, 0.13-0.39 with the written
# one. The derived line is much worse than a model and far better than nothing,
# which is the trade `none` is making.
#
# A model too small to hold the batch contract is worse than none: qwen2.5:1.5b
# returned 14 contexts for a batch of 8, so every batch failed and fell back to
# the derived line anyway — after spending the time.
# CONTEXT_PROVIDER=
# CONTEXT_MODEL=

# ============================================================================
# 3d. ABLATION
# ============================================================================
# Switches pipeline stages OFF, so "better than plain RAG" can be measured
# instead of asserted. Comma-separated; unknown names are rejected at startup.
#
#   sparse      dense-only retrieval, no lexical half, no fusion
#   rerank      keep retrieval order and retrieval scores
#   gate        no confidence threshold; TOP_K alone decides what is sent
#   citations   take the model's citations at face value, unvalidated
#   verify      no entailment check
#   llmcontext  index-time: derived context only, no model call
#   context     index-time: raw chunks, no context at all (implies llmcontext)
#
# The last two change the vectors, so they need their own QDRANT_COLLECTION and
# a re-ingest. `ask-my-docs ablate` walks the query-time ladder and prints the
# commands for the index-time rungs.
# ABLATE=

# ============================================================================
# 4. EVAL JUDGE
# ============================================================================
# Left unset, the generator grades its own answers — which measured ~0.15-0.19
# too generous. Comparing two generators is only meaningful under one shared
# judge, so point this at a model that had no hand in writing the answers.
# JUDGE_PROVIDER=openai            # ollama | cloud | openai
# OPENAI_JUDGE_MODEL=

# ============================================================================
# 5. CROSS-ENCODER RERANKER  (docker compose up -d reranker)
# ============================================================================
# Strongly recommended. Ollama has no rerank endpoint, so without this the
# reranker is an LLM scoring passages: ~23x slower and badly calibrated.
# Unset it and the pipeline still works, just worse.
RERANKER_URL=http://localhost:8081
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# TEI_IMAGE=cpu-1.7                # 89-1.7 for RTX 40xx, 86-1.7 for 30xx, etc.

# ============================================================================
# 6. QDRANT
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docs
QDRANT_CACHE_COLLECTION=query_cache
QDRANT_SHARDS=4

# Vector width is probed from the embedding model. Set it only to assert a
# value you expect — a mismatch then errors instead of silently retrieving
# badly. Changing embedding model requires a full re-index into a NEW
# QDRANT_COLLECTION — widths differ (bge-m3 1024, nemotron-3-embed-1b 2048) and
# Qdrant rejects the mismatched points rather than migrating them.
# EMBED_DIM=
EMBED_BATCH=64

# ============================================================================
# 7. CHUNKING  (changing these requires a re-index and a new baseline)
# ============================================================================
# Which reader parses PDFs.
#   (unset)     built-in, pure Go, keeps this a single static binary
#   pdftotext   poppler, if it is on PATH — needs `apt install poppler-utils`
#
# The built-in reader fails on a whole class of real documents. It infers a
# space from the gap between two positioned runs, which is the only evidence a
# PDF gives; when a producer reports no glyph widths there is no gap to measure
# and every word runs together. Measured on a LaTeX textbook: 352 pages where
# "different" appeared 0 times, versus 121 with pdftotext, which also rejoins
# words hyphenated across a line break. Ingest refuses such a document rather
# than indexing it unsearchable, and names this variable.
#
# Opt-in rather than automatic on purpose: chunk ids are the eval contract, and
# an extractor picked by whatever happens to be installed would give two
# machines different ids for the same file.
# PDF_EXTRACTOR=

MAX_CHUNK_CHARS=1600
CHUNK_OVERLAP=200
INGEST_CONCURRENCY=8

# Ceiling on how much of a document contextualization resends per batch.
# Without it the body goes into every batch's system prompt, so a document costs
# ceil(chunks/batch) x its own length in prompt tokens — quadratic. Measured on
# a 197-chunk CSV: ~1.9M tokens unbounded, ~93x less at this setting, because
# what the model needs from "the document" is what it IS (the opening lines and
# the heading outline), not every word — the text around a chunk is already in
# the batch. Raise it if contexts come back vague on long documents; 0 sends
# the whole body and restores the quadratic.
CONTEXT_DOC_CHARS=6000

# ============================================================================
# 8. RETRIEVAL
# ============================================================================
CANDIDATE_K=50                     # fused candidates sent to the reranker
RERANKER_BATCH=32                  # per-request cap; TEI rejects batches over 32
TOP_K=10                           # ceiling on chunks sent to the model, not a quota

# Confidence gate. Also filters which sources reach the model — padding the
# prompt with sub-threshold chunks buries the answer and makes small models
# refuse outright. The right value is reranker- AND corpus-specific, so derive
# it rather than guessing:  ./ask-my-docs calibrate
# Unset, it defaults per backend (0.30 LLM scorer / 0.01 cross-encoder).
# MIN_RERANK_SCORE=

# Relative gate. The absolute threshold above is only a floor; the effective
# bar is max(MIN_RERANK_SCORE, RERANK_MARGIN x median candidate score). A fixed
# sigmoid number does not transfer between corpora — the same reranker scores a
# prose answer 0.99 and an equally correct comma-separated list 0.008 — so the
# margin over the noise floor is what actually generalises. Set 0 to disable.
RERANK_MARGIN=3.0

CACHE_THRESHOLD=0.97               # semantic-cache similarity
REQUEST_TIMEOUT_SEC=240            # per-query budget for /query

# ============================================================================
# 9. CLOUD PROVIDER (PROVIDER=cloud)
# ============================================================================
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2.5

ADDR=:8080

# ============================================================================
# 10. AUTHENTICATION  (serve only)
# ============================================================================
# A JSON array of principals. Each one carries the ACL tags it may retrieve,
# and `serve` uses those instead of anything the request body claims — before
# this existed, a caller asking for documents tagged "hr-confidential" simply
# said so in the JSON and got them.
#
#   ask-my-docs token alice     # prints a token and the entry to paste here
#
#   [{"name":"alice","token_sha256":"<64 hex>","acl":["finance"],"admin":false}]
#
# acl:["*"] means unrestricted. An empty list is refused at startup rather than
# read as "no filter" — that reading is how a config slip becomes a data leak.
# admin:true is required to upload documents or switch models; both change what
# every other caller sees.
#
# Only the hash is stored, so the token itself is unrecoverable from this file
# and a lost one is reissued rather than looked up.
# AUTH_TOKENS_FILE=tokens.json

# Serve with no authentication at all: every caller reads every indexed
# document, uploads more, and switches models. `serve` refuses to start unless
# one of these two variables is set, because the failure mode of a default-open
# server is silence. Fine for a local demo; set AUTH_TOKENS_FILE for anything
# that is reachable by something you do not trust.
# ALLOW_ANONYMOUS=1

# GET /healthz and the UI page itself stay open regardless — a health check
# that needs a credential is not usable by a load balancer, and the HTML has no
# data in it. Everything that touches documents is behind the token.
