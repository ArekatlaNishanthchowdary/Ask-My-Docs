{"id": "ci-travel-ceiling", "query": "How much can I spend on a trip before somebody has to sign it off?", "relevant_chunk_ids": ["orbital-handbook.md#1"], "stage": "retrieval", "answer_contains": "1,200 EUR per trip"}
