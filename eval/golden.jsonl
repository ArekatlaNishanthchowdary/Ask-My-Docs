{"id": "riq-revenue", "query": "How does RestaurantIQ make money?", "relevant_chunk_ids": ["RestaurantIQ_AI_Customer_Experience_Platform_Proposal.md#11"], "gold_answer": "A monthly SaaS subscription, with optional hardware sales for NFC stands. Recurring software revenue is the primary model.", "stage": "generation"}
